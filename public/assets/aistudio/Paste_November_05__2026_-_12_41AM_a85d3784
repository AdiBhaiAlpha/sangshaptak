        // Breakpoint
        var isBreakPoint = function (bp) {
            var bps = [320, 576, 768, 820, 992, 1200],
                w = $(window).innerWidth(),
                min, max
            for (var i = 0, l = bps.length; i < l; i++) {
                if (bps[i] === bp) {
                    min = bps[i-1] || 0
                    max = bps[i]
                    break
                }
            }
            return w > min && w <= max
        }

        //Mobile menu script
        $(function() {
            $('.follow-items').appendTo('.site-mobile-menu');
